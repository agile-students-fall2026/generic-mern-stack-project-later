# copy this to front-end/.env (don't commit .env)
# vite only picks up vars starting with VITE_, restart npm run dev after editing
# anything here ends up in the browser so no secrets

VITE_API_URL=http://localhost:3000

# optional, PlaceMap falls back to openstreetmap if these are empty
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=